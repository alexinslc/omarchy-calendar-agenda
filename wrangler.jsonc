{
  "name": "omarchy-calendar-agenda-site",
  "compatibility_date": "2026-08-24",
  "main": "worker.js",
  "workers_dev": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/oauth/client-config"]
  },
  "secrets": {
    "required": ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET"]
  },
  "routes": [
    {
      "pattern": "calendar.alexinslc.com",
      "custom_domain": true
    }
  ]
}
